# Project specific
!.omp/
# team-config state: only gate records (evidence/gate) and reviewer trailers (*trailer*) stay addable;
# ledger, gate-deltas, frontend-design state and QA output are local.
/.omp/team-config/*
!/.omp/team-config/evidence/
/.omp/team-config/evidence/**/*
!/.omp/team-config/evidence/**/
!/.omp/team-config/evidence/gate/**
!/.omp/team-config/evidence/**/*trailer*
.omp/plugins/
.pi_config/
.opencode/
.worktrees/
.worktree/
compaction-results/
changes/
!/openspec/changes/
__pycache__/

# .omo policy: only plans, gate records (evidence/gate) and reviewer trailers (*trailer*) stay addable.
# QA outputs, runs, gate-deltas, ledgers and drafts are local. Tracked files stay tracked.
/.omo/*
!/.omo/plans/
!/.omo/evidence/
/.omo/evidence/**/*
!/.omo/evidence/**/
!/.omo/evidence/gate/**
!/.omo/evidence/**/*trailer*
# historical trailer cited by gate/merge-gate-worktree-records.json
!/.omo/evidence/merge-gate-worktree-records/wave-4/f2-audit-pass.md

# Scratch files
syntax.jsonl
out.jsonl
out.html
pi-*.html
.close_issue.sh

