+
+// F3 B1: the smoke log is evidence a later checkout must be able to open, so it is verified like a
+// trailer: tracked, not ignored, read once, and pinned so a commit adding it after `reviewed_sha`
+// keeps the record valid.
+for (const placement of ["untracked", "ignored"]) {
+  test(`#given a ${placement} smoke artifact #when validated #then qa.0.artifact blocks`, () => {
+    withScenario({ smokePlacement: placement }, (s) => {
+      expectFolderBlocked(s.validate(), /qa\.0\.artifact/)
+    })
+  })
+}
+
+test("#given a smoke artifact first committed with the record after the review #when validated #then it still passes", () => {
+  withScenario({ smokePlacement: "untracked" }, (s) => {
+    const { git } = s.repository
+    git("add", "--intent-to-add", "--", "evidence/smoke.txt")
+    expectFolderPassed(s.validate())
+    git("add", "-A")
+    git("commit", "-q", "-m", "gate evidence with smoke log")
+    expectFolderPassed(s.validate())
+  })
+})
+
+test("#given a fresh clone of a repo holding the record, trailer and smoke log #when validated #then it passes", () => {
+  withScenario({ smokePlacement: "untracked" }, (s) => {
+    const { git, directory } = s.repository
+    git("add", "-A")
+    git("commit", "-q", "-m", "gate evidence with smoke log")
+    const clone = mkdtempSync(path.join(tmpdir(), "omo-gate-clone-"))
+    try {
+      execFileSync("git", ["clone", "-q", directory, clone], { encoding: "utf8" })
+      const result = spawnSync(process.execPath, [validator, "--record", path.join(clone, "evidence/merge-gate.json"), "--plan", path.join(clone, FOLDER), "--repo", clone], { encoding: "utf8" })
+      expectFolderPassed(result)
+    } finally {
+      rmSync(clone, { recursive: true, force: true })
+    }
+  })
+})
+
+test("#given a not-needed Whole-diff reason that differs from the record's #when validated #then whole_diff.reason blocks", () => {
+  withScenario({}, (s) => {
+    s.record.whole_diff = { run: false, reason: "a different justification" }
+    s.save()
+    expectFolderBlocked(s.validate(), /whole_diff\.reason/)
+  })
+})
