+    /**
+     * The surface is a container the `WebView` is added to once no close is in flight: a `WebView` created earlier would bind to the
+     * renderer process of a closing preview, and the termination at that preview's Stop deadline would end the new page with it.
+     */
     private fun openView(context: Context): View {
-        val existing = view
+        val existing = host
         if (existing != null) return existing
-        if (stopped) return View(context)
-        return createView(context)
+        val container = FrameLayout(context)
+        host = container
+        if (stopped) return container
+        log.record(PreviewLogEvent.StateChanged(PreviewLogState.Loading))
+        Closing.whenIdle {
+            if (on(Guard.StateClearing)) {
+                // A fresh preview starts on an empty jar, whatever an earlier open or another view left in it.
+                CookieManager.getInstance().removeAllCookies { main.post { attach(container, context) } }
+            } else {
+                attach(container, context)
+            }
+        }
+        return container
+    }
+
+    private fun attach(container: FrameLayout, context: Context) {
+        if (stopped || view != null || host !== container) return
+        val web = createView(context)
+        container.addView(web, FrameLayout.LayoutParams(FrameLayout.LayoutParams.MATCH_PARENT, FrameLayout.LayoutParams.MATCH_PARENT))
+        web.loadUrl(pendingUrl)
     }
 
